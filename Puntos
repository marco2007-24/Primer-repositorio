Algoritmo Puntos()
  Inicio
          Definir x1, y1, x2, y2, distancia, xm, ym Como Real
          Escribir "Ingrese x1, y1:"
          Leer x1, y1
          Escribir "Ingrese x2, y2:"
          Leer x2, y2
      
          distancia <- Raiz((x2-x1)^2 + (y2-y1)^2)
          xm <- (x1+x2)/2
          ym <- (y1+y2)/2
      
          Escribir "Distancia: ", distancia
          Escribir "Punto medio: (", xm, ", ", ym, ")"
 Fin
