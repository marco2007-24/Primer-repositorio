Algoritmo Estacion()
  Inicio
          Definir mes, dia Como Entero
          Escribir "Ingrese el mes (1-12):"
          Leer mes
          Escribir "Ingrese el día:"
          Leer dia
      
          Si (mes=12 Y dia>=21 Y dia<=31) O mes=1 O mes=2 O (mes=3 Y dia>=1 Y dia<=20) Entonces
              Escribir "Verano"
          SiNo
              Si (mes=3 Y dia>=21 Y dia<=31) O mes=4 O mes=5 O (mes=6 Y dia>=1 Y dia<=20) Entonces
                  Escribir "Otoño"
              SiNo
                  Si (mes=6 Y dia>=21 Y dia<=30) O mes=7 O mes=8 O (mes=9 Y dia>=1 Y dia<=22) Entonces
                      Escribir "Invierno"
                  SiNo
                      Si (mes=9 Y dia>=23 Y dia<=30) O mes=10 O mes=11 O (mes=12 Y dia>=1 Y dia<=20) Entonces
                          Escribir "Primavera"
                      SiNo
                          Escribir "Fecha no válida"
                      FinSi
                  FinSi
              FinSi
          FinSi
 Fin
