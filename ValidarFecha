Algoritmo ValidarFecha()
  Inicio
          Definir dia, mes, anio, maxDia Como Entero
          Definir bisiesto Como Logico
      
          Escribir "Ingrese el día, mes y año:"
          Leer dia, mes, anio
      
          Si mes < 1 O mes > 12 Entonces
              Escribir "Fecha no válida"
          SiNo
              bisiesto <- (anio MOD 400 = 0) O ((anio MOD 4 = 0) Y (anio MOD 100 <> 0))
      
              Segun mes Hacer
                  1, 3, 5, 7, 8, 10, 12:
                      maxDia <- 31
                  4, 6, 9, 11:
                      maxDia <- 30
                  2:
                      Si bisiesto Entonces
                          maxDia <- 29
                      SiNo
                          maxDia <- 28
                      FinSi
              FinSegun
      
              Si dia >= 1 Y dia <= maxDia Entonces
                  Escribir "Fecha válida"
              SiNo
                  Escribir "Fecha no válida"
              FinSi
          FinSi
  Fin
