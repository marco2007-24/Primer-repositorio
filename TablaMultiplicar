Algoritmo TablaMultiplicar()
  Inicio
          Definir k, i, resultado Como Entero
          Escribir "Ingrese un número entero:"
          Leer k
      
          Para i <- 1 Hasta 10 Hacer
              resultado <- k * i
              Escribir k, " x ", i, " = ", resultado
          FinPara
  Fin
