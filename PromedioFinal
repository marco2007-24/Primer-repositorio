Algoritmo Promedio_Final
   Inicio
         
             Definir nota1, nota2, nota3, promedio Como Real
             Escribir "Ingrese la nota del primer parcial:"
             Leer nota1
             Mientras nota1 < 0 O nota1 > 10 Hacer
                 Escribir "Nota incorrecta. Ingrese nuevamente:"
                 Leer nota1
             FinMientras
         
             Escribir "Ingrese la nota del segundo parcial:"
             Leer nota2
             Mientras nota2 < 0 O nota2 > 10 Hacer
                 Escribir "Nota incorrecta. Ingrese nuevamente:"
                 Leer nota2
             FinMientras
         
             Escribir "Ingrese la nota del tercer parcial:"
             Leer nota3
             Mientras nota3 < 0 O nota3 > 10 Hacer
                 Escribir "Nota incorrecta. Ingrese nuevamente:"
                 Leer nota3
             FinMientras
         
             promedio <- nota1 * 0.30 + nota2 * 0.30 + nota3 * 0.40
         
             Escribir "El promedio final es: ", promedio
         
              Si promedio >= 7 Hacer
                 Escribir "El estudiante aprueba"
               Sino
                 Escribir"El estudiante no aprueba"
             FinSi
    Fin
