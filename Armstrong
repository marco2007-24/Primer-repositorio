Algoritmo Armstrong
  Inicio
          Definir numero, temporal, digito, suma Como Entero
          Escribir "Ingrese un numero de tres digitos:"
          Leer numero
          Si numero < 100 O numero > 999 Entonces
              Escribir "No tiene tres digitos"
          SiNo
              temporal <- numero
              suma <- 0
              Mientras temporal > 0 Hacer
                  digito <- temporal MOD 10
                  suma <- suma+digito^3
                  temporal <- TRUNC(temporal/10)
              FinMientras
              Si suma = numero Entonces
                  Escribir "Es Armstrong"
              SiNo
                  Escribir "No es Armstrong"
              FinSi
          FinSi
  Fin
