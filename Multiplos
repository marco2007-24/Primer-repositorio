Algoritmo Multiplos()
  Inicio
          Definir n, i, contador, suma Como Entero
          Escribir "Ingrese N:"
          Leer n
          contador <- 0
          suma <- 0
          Para i <- 1 Hasta n Hacer
              Si i MOD 3 = 0 O i MOD 5 = 0 Entonces
                  contador <- contador+1
                  suma <- suma+i
              FinSi
          FinPara
          Escribir "Cantidad: ", contador
          Escribir "Suma: ", suma
 Fin
