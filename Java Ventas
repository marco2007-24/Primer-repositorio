
import java.util.Scanner;

public class Ventas {
    public static void main(String[] args) {
        Scanner leer = new Scanner(System.in);

        double venta, total = 0, promedio, mayor = 0;
        int dias = 0, contador = 0, diaMayor = 0;

        System.out.print("Ingrese la venta (-1 para terminar): ");
        venta = leer.nextDouble();

        while (venta != -1) {
            dias++;
            total += venta;

            if (venta > 500) {
                contador++;
            }

            if (dias == 1 || venta > mayor) {
                mayor = venta;
                diaMayor = dias;
            }

            System.out.print("Ingrese la venta (-1 para terminar): ");
            venta = leer.nextDouble();
        }

        if (dias > 0) {
            promedio = total / dias;

            System.out.println("Total de ventas: " + total);
            System.out.println("Promedio: " + promedio);
            System.out.println("Dias con ventas mayores a $500: " + contador);
            System.out.println("Mayor venta: " + mayor);
            System.out.println("Dia de la mayor venta: " + diaMayor);
        } else {
            System.out.println("No se ingresaron ventas");
        }

        leer.close();
    }
}
